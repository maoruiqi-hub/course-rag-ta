# ===== 对话模型（必填）=====
# DeepSeek 官方 API；也可以换成任意 OpenAI 兼容服务
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 2026 年 DeepSeek 默认开启 thinking；本应用关闭它以获得稳定、低延迟的问答与工具调用
LLM_DISABLE_THINKING=true
REQUEST_TIMEOUT=120

# ===== Embedding 方案 A：SiliconFlow（需要账户余额）=====
# 国际站模型：Qwen/Qwen3-Embedding-0.6B（1024 维）
# 国内站可改为 https://api.siliconflow.cn/v1 + BAAI/bge-m3
EMBEDDING_PROVIDER=fastembed
# EMBEDDING_PROVIDER=siliconflow
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.com/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# ===== Embedding 方案 B：本地 FastEmbed（无需 embedding key）=====
# 默认使用 BAAI/bge-small-zh-v1.5（512 维，首次运行下载约 100MB）
FASTEMBED_MODEL=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com

# ===== 应用设置 =====
CHROMA_DIR=./chroma_db
UPLOAD_DIR=./data/uploads
TOP_K=5
SUMMARY_THRESHOLD=20000
ENABLE_AGENT=true
